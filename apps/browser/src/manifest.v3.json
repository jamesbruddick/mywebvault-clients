{
  "manifest_version": 3,
  "minimum_chrome_version": "134.0",
  "name": "__MSG_extName__",
  "short_name": "myWebVault",
  "version": "2026.9.3",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "author": "myWebVault",
  "homepage_url": "https://github.com/jamesbruddick/mywebvault-clients",
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "96": "images/icon96.png",
    "128": "images/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "__firefox__background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_icon": {
      "19": "images/icon19.png",
      "38": "images/icon38.png"
    },
    "default_title": "myWebVault",
    "default_popup": "popup/index.html"
  },
  "permissions": [
    "activeTab",
    "alarms",
    "clipboardWrite",
    "contextMenus",
    "favicon",
    "idle",
    "offscreen",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "__firefox__permissions": [
    "activeTab",
    "alarms",
    "clipboardWrite",
    "contextMenus",
    "idle",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "__safari__permissions": [
    "activeTab",
    "alarms",
    "clipboardWrite",
    "contextMenus",
    "idle",
    "offscreen",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "optional_permissions": ["bookmarks", "nativeMessaging"],
  "__firefox__optional_permissions": ["bookmarks"],
  "__safari__optional_permissions": null,
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
    "__chrome__sandbox": "sandbox allow-scripts; script-src 'self'"
  },
  "sandbox": {
    "pages": ["overlay/menu-button.html", "overlay/menu-list.html"]
  },
  "__firefox__sandbox": null,
  "__chrome__side_panel": {
    "default_path": "sidepanel-disabled.html"
  },
  "commands": {
    "_execute_action": {
      "description": "__MSG_commandOpenPopup__"
    },
    "__firefox___execute_sidebar_action": {
      "description": "__MSG_commandOpenSidebar__"
    },
    "__opera___execute_sidebar_action": {
      "description": "__MSG_commandOpenSidebar__"
    },
    "lock_vault": {
      "description": "__MSG_commandLockVaultDesc__"
    },
    "open_search": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "__MSG_commandOpenSearch__"
    }
  },
  "__firefox__browser_specific_settings": {
    "gecko": {
      "id": "{a612e095-ebd7-4df1-a9df-aa4322e433eb}",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "__firefox__sidebar_action": {
    "default_title": "myWebVault",
    "default_panel": "popup/index.html?uilocation=sidebar",
    "default_icon": "images/icon19.png",
    "open_at_install": false
  },
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "__firefox__storage": null,
  "__opera__sidebar_action": {
    "default_title": "myWebVault",
    "default_panel": "popup/index.html?uilocation=sidebar",
    "default_icon": "images/icon19.png",
    "open_at_install": false,
    "browser_style": false
  },
  "web_accessible_resources": [
    {
      "resources": ["search/search.html"],
      "matches": ["<all_urls>"],
      "use_dynamic_url": true
    }
  ]
}
